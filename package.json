{
  "name": "intervencija-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:site",
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./assets/tailwind.css -o ./assets/site.css --minify",
    "build:site": "node scripts/build-site.mjs",
    "ci:pages": "npm run build && npm run verify && npm run verify:dist",
    "serve": "HOST=0.0.0.0 node server.mjs",
    "serve:local": "HOST=127.0.0.1 node server.mjs",
    "serve:lan": "HOST=0.0.0.0 node server.mjs",
    "verify": "node scripts/verify-site.mjs",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
